{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rahulprasad29V/cybersecurity-roadmap/blob/main/quizzes/quiz.schema.json",
  "title": "CyberWolf Quiz",
  "type": "object",
  "required": ["format_version", "title", "level", "category", "questions"],
  "properties": {
    "format_version": { "const": 1 },
    "title": { "type": "string", "minLength": 3 },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "category": { "type": "string", "minLength": 2 },
    "description": { "type": "string" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "difficulty", "prompt", "options", "correct_option", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "topic": { "type": "string" },
          "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
          "prompt": { "type": "string", "minLength": 8 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-D]$" },
                "text": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "correct_option": { "type": "string", "pattern": "^[A-D]$" },
          "explanation": { "type": "string", "minLength": 10 },
          "reference": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
