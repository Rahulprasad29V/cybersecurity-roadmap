{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberWolf Competency Curriculum",
  "type": "object",
  "required": ["format_version", "title", "edition", "language", "levels", "modules"],
  "properties": {
    "format_version": { "const": 1 },
    "title": { "type": "string", "minLength": 3 },
    "edition": { "type": "string" },
    "language": { "const": "en" },
    "levels": {
      "type": "array",
      "items": { "enum": ["beginner", "intermediate", "advanced"] },
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "path", "estimated_hours", "prerequisites", "learning_outcomes", "deliverable"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 3 },
          "level": { "enum": ["beginner", "intermediate", "advanced"] },
          "path": { "type": "string" },
          "estimated_hours": { "type": "integer", "minimum": 1 },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "learning_outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "deliverable": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
